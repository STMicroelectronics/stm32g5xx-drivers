{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:ICACHE",
  "grammarVersion": "3.1",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "title": "General information",
          "type": "object",
          "properties": {
            "labels": {
              "title": "Add a label",
              "type": "array",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "title": "Software layer",
              "type": "string",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_ICACHE_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "title": "Resource initialization code generation",
              "type": "string",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "actions": [
                {
                  "type": "warning",
                  "condition": "$info.init_type != 'called'",
                  "message": "The tool will not call ICACHE initialization automatically at startup. Call the generated initialization function from your application."
                }
              ],
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_ICACHE_CORE_ENABLED",
                  "value": true
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "title": "Main features",
          "type": "object",
          "properties": {
            "associativity_mode": {
              "title": "Associativity mode",
              "type": "string",
              "description": "Choose whether each cache line uses one or two storage paths, called ways. One way prioritizes lower power consumption; two ways prioritize cache performance.",
              "oneOf": [
                {
                  "title": "1-way",
                  "const": "1WAY",
                  "description": "Use one storage path to reduce power consumption."
                },
                {
                  "title": "2-way",
                  "const": "2WAYS",
                  "description": "Use two storage paths to improve cache performance."
                }
              ],
              "default": "2WAYS"
            }
          }
        },
        "additional": {
          "title": "Advanced features",
          "type": "object",
          "properties": {
            "enable_ecc": {
              "title": "Error correction code (ECC)",
              "description": "Detect and correct certain memory errors while the cache is operating.",
              "type": "boolean",
              "actions": [
                {
                  "type": "include",
                  "condition": "$resource.features.Ecc"
                }
              ],
              "default": false
            },
            "single_ecc_error": {
              "title": "Single-bit ECC errors",
              "type": "boolean",
              "description": "Notify the processor when ECC detects an error affecting one bit.",
              "default": false,
              "actions": [
                {
                  "type": "include",
                  "condition": "$resource.features.Ecc"
                },
                {
                  "type": "enable",
                  "condition": "$additional.enable_ecc",
                  "message": "Enable error correction code (ECC) to use this option."
                },
                {
                  "type": "set",
                  "condition": "!($additional.enable_ecc)",
                  "attributes": {
                    "const": false
                  }
                }
              ]
            },
            "double_ecc_error": {
              "title": "Double-bit ECC errors",
              "type": "boolean",
              "description": "Notify the processor when ECC detects an error affecting two bits.",
              "default": false,
              "actions": [
                {
                  "type": "include",
                  "condition": "$resource.features.Ecc"
                },
                {
                  "type": "enable",
                  "condition": "$additional.enable_ecc",
                  "message": "Enable error correction code (ECC) to use this option."
                },
                {
                  "type": "set",
                  "condition": "!($additional.enable_ecc)",
                  "attributes": {
                    "const": false
                  }
                }
              ]
            },
            "remap_regions": {
              "title": "Memory address remapping",
              "description": "Map a code alias address range to a destination external physical address.",
              "type": "array",
              "source": "Array.from({ length: ($resource.features.Region)}, (_, i) => ({ id: ('REGION_' + i ) }))",
              "itemId": "id",
              "itemVar": "region",
              "items": {
                "type": "object",
                "properties": {
                  "use_region": {
                    "title": "Use region",
                    "type": "boolean",
                    "default": false
                  },
                  "size": {
                    "title": "Size in megabytes",
                    "type": "integer",
                    "description": "Choose the region size from 2 to 128 megabytes. The size must be a power-of-two multiple of 2 megabytes.",
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.use_region",
                        "message": "Enable this region before setting its size."
                      }
                    ],
                    "oneOf": [
                      {
                        "title": "2",
                        "const": 2
                      },
                      {
                        "title": "4",
                        "const": 4
                      },
                      {
                        "title": "8",
                        "const": 8
                      },
                      {
                        "title": "16",
                        "const": 16
                      },
                      {
                        "title": "32",
                        "const": 32
                      },
                      {
                        "title": "64",
                        "const": 64
                      },
                      {
                        "title": "128",
                        "const": 128
                      }
                    ],
                    "default": 2
                  },
                  "base_address": {
                    "title": "Code alias base address",
                    "type": "integer",
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.use_region",
                        "message": "Enable this region before setting its code alias base address."
                      }
                    ],
                    "description": "Set the code alias base address in hexadecimal, from 0x00000000 through 0x1FE00000. This address identifies the code region that ICACHE remaps.",
                    "minimum": 0,
                    "maximum": 534773760,
                    "display_format": [
                      "hex"
                    ],
                    "default": 0
                  },
                  "remap_address": {
                    "title": "External physical remap address",
                    "type": "integer",
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.use_region",
                        "message": "Enable this region before setting its external physical address."
                      }
                    ],
                    "description": "Set the external physical remap address in hexadecimal, from 0x00000000 through 0xFFE00000. ICACHE replaces the matching code alias address with this address when it remaps a request.",
                    "minimum": 0,
                    "maximum": 4292870144,
                    "display_format": [
                      "hex"
                    ],
                    "default": 0
                  },
                  "master_port": {
                    "title": "Master port",
                    "description": "Select the path that carries cache requests between the cache and memory. Master 1 uses the primary bus. On devices with two ports, Master 2 uses the secondary bus.",
                    "type": "integer",
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.use_region && ($resource.features.SMaster !== 0)",
                        "message": "Enable this region first. Master 2 is available only on devices that support two master ports."
                      },
                      {
                        "type": "set",
                        "condition": "$resource.features.SMaster === 0",
                        "attributes": {
                          "description": "This device supports only Master 1, which sends cache requests through the primary bus."
                        }
                      },
                      {
                        "type": "set",
                        "condition": "$resource.features.SMaster !== 0",
                        "attributes": {
                          "description": "This device supports two master ports. Master 1 uses the primary bus, and Master 2 uses the secondary bus."
                        }
                      }
                    ],
                    "oneOf": [
                      {
                        "title": "Master 1 port",
                        "const": 1
                      },
                      {
                        "title": "Master 2 port",
                        "const": 2,
                        "actions": [
                          {
                            "type": "exclude",
                            "condition": "$resource.features.SMaster === 0"
                          }
                        ]
                      }
                    ],
                    "default": 1
                  },
                  "output_burst": {
                    "title": "Read burst type",
                    "type": "string",
                    "description": "Choose how ICACHE reads consecutive data through the Advanced High-Performance Bus (AHB), which transfers data between the cache and memory. Increment continues at the next address after each transfer. Wrap returns to the beginning of the fixed-size cache line after reaching its end.",
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.use_region",
                        "message": "Enable this region before selecting a read burst type."
                      }
                    ],
                    "oneOf": [
                      {
                        "title": "Wrap",
                        "description": "Return to the beginning of the fixed-size cache line after reaching its end.",
                        "const": "WRAP"
                      },
                      {
                        "title": "Increment",
                        "const": "INCR",
                        "description": "Continue at the next address after each data transfer."
                      }
                    ],
                    "default": "WRAP"
                  }
                }
              }
            },
            "monitors": {
              "title": "Monitors",
              "description": "Count instruction-cache read requests that find the requested data and requests that do not.",
              "type": "object",
              "properties": {
                "hit_monitor": {
                  "title": "Cache hit monitor",
                  "type": "boolean",
                  "description": "Count Advanced High-Performance Bus (AHB) read requests whose data is found in the instruction cache (ICACHE).",
                  "default": false
                },
                "miss_monitor": {
                  "title": "Cache miss monitor",
                  "type": "boolean",
                  "description": "Count Advanced High-Performance Bus (AHB) read requests whose data is not found in the instruction cache (ICACHE).",
                  "default": false
                }
              }
            }
          }
        },
        "system": {
          "title": "System",
          "type": "object",
          "properties": {
            "nvic": {
              "title": "NVIC",
              "type": "object",
              "properties": {
                "enable_interruption": {
                  "title": "Interrupt",
                  "description": "Allow the instruction cache (ICACHE) to send an interrupt request to the processor.",
                  "type": "boolean",
                  "default": false
                },
                "irq_handler_generation": {
                  "title": "IRQ handler generation",
                  "description": "Generate the code that runs when an instruction-cache interrupt request (IRQ) occurs.",
                  "type": "boolean",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($info.layer === 'HAL') && $system.nvic.enable_interruption"
                    }
                  ]
                },
                "chose_error_interrupt": {
                  "title": "ICACHE interrupts at startup",
                  "type": "object",
                  "description": "Select the instruction cache (ICACHE) interrupts that the tool enables when the peripheral starts.",
                  "properties": {
                    "cache_error": {
                      "title": "Cache error",
                      "type": "boolean",
                      "description": "Notify the processor when the instruction cache (ICACHE) detects an error.",
                      "default": false,
                      "actions": [
                        {
                          "type": "enable",
                          "condition": "($system.nvic.enable_interruption)",
                          "message": "Enable the ICACHE interrupt first."
                        },
                        {
                          "type": "set",
                          "condition": "!($system.nvic.enable_interruption)",
                          "attributes": {
                            "const": false
                          }
                        }
                      ]
                    }
                  }
                },
                "irq_config1": {
                  "title": "IRQ line priority",
                  "type": "object",
                  "description": "Choose which pending interrupt the Nested Vectored Interrupt Controller handles first.",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}