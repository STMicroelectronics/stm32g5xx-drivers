{{! **************************************************************************** }}
{{! Generation of mx_rcc_[osc]_clock_config or mx_rcc_[osc]_clock_deactivate     }}
{{! Generation of mx_rcc_[pll]_config or mx_rcc_[pll]_deactivate     }}
{{! ****************************************************************************~}}
{{~assign 'do_rcc_ll_optim' false~}}{{! LL optimization for RCC is disabled - following functions are called at runtime ~}}

{{~#unless (helper_rcc_is_central @root.rcc_ctx)}}

  {{#each used_oscillators}}
    {{~assign 'osc' (lowercase this)}}

/**
  * configure and enable {{this}} oscillator
  * @param nb_resources Number of resources which requests to configure the clock
  */
system_status_t mx_rcc_{{@root.osc}}_clock_config(uint32_t nb_resources)
{
  if (RCC_IS_RESOURCE_FREE({{@root.osc}}))
  {
  {{>RCC_LOCAL fct='generate_enable_osc' osc=@root.osc}}

  }
  RCC_CONSUME_RESOURCE({{@root.osc}}, nb_resources);

  return SYSTEM_OK;
}

/**
  * Disable {{this}} oscillator
  */
system_status_t mx_rcc_{{@root.osc}}_clock_deactivate(void)
{
  RCC_RELEASE_RESOURCE({{@root.osc}});

  if (RCC_IS_RESOURCE_FREE({{@root.osc}}))
  {
  {{>RCC_LOCAL fct='generate_disable_osc' osc=@root.osc}}
  }
  return SYSTEM_OK;
}

  {{/each~}}

  {{#eachObject @root.system_config.pll_used}}
  {{#if (or (include @root.all_ppp_clock_configs value.name) (eq @root.system_config.clock_source.pll_name value.name))}}

/**
  * Configure PLL{{value.idx}} (all factors {{#each value.factors}}{{value}}, {{/each}}{{#each value.outputs}}{{value}}{{#if (not @last)}}, {{/if}}{{/each}}) and activate it.
  * Only PLL{{value.idx}} is enabled, not the PLL{{value.idx}} outputs.
  */
system_status_t mx_rcc_pll{{value.idx}}_config(void)
{
  if (RCC_IS_RESOURCE_FREE(pll{{value.idx}}))
  {
    /* Enable the oscillator used as PLL{{value.idx}} input */
    if (mx_rcc_{{lowercase value.config.src}}_clock_config(1) != SYSTEM_OK)
    {
      return SYSTEM_CLOCK_ERROR;
    }

    /* Configure and enable PLL{{value.idx}} */
  {{>RCC_LOCAL fct='generate_pll_config_enable' pll_info=value}}

    RCC_CONSUME_RESOURCE(pll{{value.idx}}, 1);
  }

  return SYSTEM_OK;
}

/**
  * Deactivate PLL{{value.idx}}
  */
system_status_t mx_rcc_pll{{value.idx}}_deactivate(void)
{
  /* Deactivation is possible only if the outputs are free */
  if (RCC_IS_RESOURCE_FREE(pll{{value.idx}}p)
      && RCC_IS_RESOURCE_FREE(pll{{value.idx}}q)
      && RCC_IS_RESOURCE_FREE(pll{{value.idx}}r))
  {
    RCC_RELEASE_RESOURCE(pll{{value.idx}});
  {{>RCC_LOCAL fct='generate_pll_disable' pll_idx=value.idx}}

    /* Deactivate the oscillator used as input of the PLL{{value.idx}} */
    if (mx_rcc_{{lowercase value.config.src}}_clock_deactivate() != SYSTEM_OK)
    {
      return SYSTEM_CLOCK_ERROR;
    }
  }

  return SYSTEM_OK;
}
    {{#each value.outputs}}
/**
  * Activate PLL{{../value.idx}}{{uppercase this}} output
  * @param nb_resources Number of resources which requests to configure the output
  */
system_status_t mx_rcc_pll{{../value.idx}}_output_{{this}}_config(uint32_t nb_resources)
{
  if (RCC_IS_RESOURCE_FREE(pll{{../value.idx}}{{this}}))
  {
  {{>RCC_LOCAL fct='generate_enable_pll_output' pll_idx=../value.idx pll_output=(uppercase this)}}
  }
  RCC_CONSUME_RESOURCE(pll{{../value.idx}}{{this}}, nb_resources);

  return SYSTEM_OK;
}

/**
  * Deactivate PLL{{../value.idx}}{{uppercase this}} output
  */
system_status_t mx_rcc_pll{{../value.idx}}_output_{{this}}_deactivate(void)
{
  RCC_RELEASE_RESOURCE(pll{{../value.idx}}{{this}});
  if (RCC_IS_RESOURCE_FREE(pll{{../value.idx}}{{this}}))
  {
  {{>RCC_LOCAL fct='generate_disable_pll_output' pll_idx=../value.idx pll_output=(uppercase this)}}
  }
  return SYSTEM_OK;
}

    {{/each}}
  {{/if}}
  {{/eachObject}}
