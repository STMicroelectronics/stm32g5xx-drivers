{{! Generate crypto reset function when at least one crypto IP (CCB/PKA/RNG/HASH/SAES) is active ~}}
  {{~assign 'crypto_reset_info' (helper_rcc_get_active_crypto_ips @root.all_resources)~}}
  {{#if @root.crypto_reset_info.has_crypto}}
/**
  * Disable then reset the active crypto peripherals
  */
void mx_rcc_crypto_reset(void)
{
    {{#each @root.crypto_reset_info.active_crypto_ips~}}
      {{#if (eq @root.current_layer 'HAL')}}
  HAL_RCC_{{helper_rcc_remap_hw_resource this}}_DisableClock();
      {{else}}
        {{~assign "periph_bus" (helper_rcc_get_bus_group this)}}
  LL_{{@root.periph_bus}}_DisableClock(LL_{{@root.periph_bus}}_PERIPH_{{helper_rcc_remap_hw_resource this}});
      {{/if}}
    {{/each}}

    {{#each @root.crypto_reset_info.active_crypto_ips~}}
      {{#if (eq @root.current_layer 'HAL')}}
  HAL_RCC_{{helper_rcc_remap_hw_resource this}}_Reset();
      {{else}}
        {{~assign "periph_bus" (helper_rcc_get_bus_group this)}}
  LL_{{@root.periph_bus}}_ForceReset(LL_{{@root.periph_bus}}_PERIPH_{{helper_rcc_remap_hw_resource this}});
  LL_{{@root.periph_bus}}_ReleaseReset(LL_{{@root.periph_bus}}_PERIPH_{{helper_rcc_remap_hw_resource this}});
      {{/if}}
    {{/each}}
}

