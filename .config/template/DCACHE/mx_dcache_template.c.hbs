    Generation of getHandle functions used in HAL
~}}
hal_dcache_handle_t *{{@root.fct_name}}_gethandle(void)
{
  return &h{{@root.current_resource}};
}
    {{else}}
{{!
    Generation of initialization function used in LL
~}}
DCACHE_TypeDef *{{@root.fct_name}}_init(void)
{
  LL_AHB1_GRP1_EnableClock(LL_AHB1_GRP1_PERIPH_{{@root.current_resource}});
      {{~#with basic}}


  {{helper_common_gen_ll_code 'LL_DCACHE_SetReadBurstType' (concat 'LL_DCACHE_READ_BURST_' read_burst_type) }}
      {{~/with}}{{!basic}}
      {{~#with additional}}
        {{~assign 'monitor_list' (helper_dcache_get_monitor_list additional.monitors 'LL')}}
        {{~#if @root.monitor_list}}


  LL_DCACHE_EnableMonitors({{@root.current_resource}}, {{@root.monitor_list}});
        {{~/if}}
        {{~#if additional.enable_ecc}}


  LL_DCACHE_EnableECC({{@root.current_resource}});
         {{~assign 'ecc_interrupt_list' (helper_dcache_get_ecc_interrupt this 'LL')}}
         {{~#if @root.ecc_interrupt_list}}

  LL_DCACHE_EnableIT({{@root.current_resource}}, {{@root.ecc_interrupt_list}});

          {{~/if}}


        {{~/if}}
      {{~/with}}{{!additional}}
      {{~#with system.nvic}}
        {{~#if (and enable_interruption (eq enable_interruption true))}}


  /* Enable the interuption for DCACHE */
          {{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context irq_config1.needs @root.current_resource false)}}
{{> CORTEX fct='init' layer=@root.current_layer needs=irq_config1.needs}}
        {{~/if}}
      {{~/with}}


  return {{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
      {{~#if (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true))}}

  /* Disable the interruption for DCACHE */
{{> CORTEX fct='deinit' layer=@root.current_layer}}
      {{~/if}}

  LL_DCACHE_Disable({{@root.current_resource}});

  /* Reset monitor values */
  LL_DCACHE_ResetMonitors({{@root.current_resource}}, LL_DCACHE_MONITOR_ALL);

  /* Reset the Control Register: burst type to WRAP, command operation finished, cache disabled */
  LL_DCACHE_WRITE_REG(({{@root.current_resource}}), CR, 0U);

  /* Reset the Interrupt Enable Register: clear DERRIE, SERRIE, ERRIE, CMDENDIE and BSYENDIE flags */
  LL_DCACHE_WRITE_REG(({{@root.current_resource}}), IER, 0U);

  /* Reset the Flag Clear Register: clear DERR, SERR, ERR, CMDEND and BSYEND flags */
  LL_DCACHE_ClearFlag({{@root.current_resource}}, LL_DCACHE_FCR_ALL);

  LL_AHB1_GRP1_DisableClock(LL_AHB1_GRP1_PERIPH_{{@root.current_resource}});
}

    {{/if}}
  {{/with}}
