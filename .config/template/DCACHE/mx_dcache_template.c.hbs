  {{#with @root.dcache_cxt}}
    {{#if (eq @root.current_layer 'HAL')}}
hal_dcache_handle_t *{{@root.fct_name}}_init(void)
{
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}

  if (HAL_DCACHE_Init(&h{{@root.current_resource}}, HAL_{{uppercase @root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }
      {{~#with basic}}
        {{~#if (eq read_burst_type 'WRAP')}}


  /* Read burst type set to default value WRAP */
        {{~else}}


  if (HAL_DCACHE_SetReadBurstType(&h{{@root.current_resource}}, HAL_DCACHE_READ_BURST_{{read_burst_type}}) != HAL_OK)
  {
    return NULL;
  }
        {{~/if}}
      {{~/with}}{{!basic}}
      {{~#with additional}}
        {{~assign 'monitor_list' (helper_dcache_get_monitor_list monitors 'HAL')}}
        {{~#if @root.monitor_list}}


  HAL_DCACHE_EnableMonitors(&h{{@root.current_resource}}, {{@root.monitor_list}});
        {{~/if}}
        {{~#if enable_ecc}}


  HAL_DCACHE_ECC_Enable(&h{{@root.current_resource}});
          {{~assign 'ecc_interrupt_list' (helper_dcache_get_ecc_interrupt this 'HAL')}}
          {{~#if @root.ecc_interrupt_list}}

  HAL_DCACHE_ECC_Enable_IT(&h{{@root.current_resource}}, {{@root.ecc_interrupt_list}});

          {{~/if}}


        {{~/if}}
      {{~/with}}{{!additional}}
      {{~#with system.nvic}}
        {{~#if (and enable_interruption (eq enable_interruption true))}}


  /* Enable the interuption for DCACHE */
          {{~assign 'nvic_needs' (helper_common_concatenate_needs irq_config1.needs @root.nvic_needs)}}
{{> CORTEX fct='init' layer=@root.current_layer needs=irq_config1.needs}}
        {{~/if}}
      {{~/with}}{{!system.nvic}}

  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
      {{~#with system.nvic}}
        {{~#if (and enable_interruption (eq enable_interruption true))}}

  /* Disable the interruption for DCACHE */
          {{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context irq_config1.needs @root.current_resource irq_handler_generation)}}
{{> CORTEX fct='deinit' layer=@root.current_layer}}
        {{~/if}}
      {{~/with}}{{!system.nvic}}
  (void)HAL_DCACHE_DeInit(&h{{@root.current_resource}});

{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource~}}
}

{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
